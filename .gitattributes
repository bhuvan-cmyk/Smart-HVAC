# Normalise text files to LF in the repository.
* text=auto eol=lf

*.py text eol=lf
*.md text eol=lf
*.txt text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.json text eol=lf
*.html text eol=lf
*.css text eol=lf
*.js text eol=lf
*.cff text eol=lf
*.ino text eol=lf
*.c text eol=lf
*.h text eol=lf

# Windows launchers stay CRLF so they run in cmd.exe without surprises.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary assets.
*.jpg binary
*.jpeg binary
*.png binary
*.gif binary
*.pdf binary
*.zip binary
*.pt binary
*.onnx binary
*.bin binary
*.ppt binary
*.pptx binary
